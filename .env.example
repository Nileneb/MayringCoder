# MayringCoder — Konfigurationsvorlage
# cp .env.example .env  →  Werte eintragen  →  nie committen!
# Produktion: GitHub Actions schreibt diese Variablen via Secrets in ~/app.linn.games/.env.mayring

# ── Ollama ─────────────────────────────────────────────────────────────────
OLLAMA_URL=http://localhost:11434
OLLAMA_SSL_VERIFY=true
# Generierungs-/Text-Modelle werden NICHT per ENV konfiguriert → config/model_routes.yaml / Web-UI Einstellungen

# ── Embedding (NUR Embeddings; Generierung bleibt in model_routes.yaml) ──────
# nomic-embed-text (768d, englisch-zentriert) → bge-m3 (1024d, multilingual) für
# den DE-Anweisungen↔EN-Code-Raum (im app.linn.games-P5-Screening belegt).
EMBEDDING_MODEL=nomic-embed-text
# Blue-green Collection-Switch der bge-m3-Migration: zeigt auf die live bediente
# Chroma-Collection. Cutover: erst memory_chunks_bge neu embedden, DANN beide
# Vars gemeinsam umschalten (sonst Dim-Mismatch 768↔1024).
MEMORY_CHUNKS_COLLECTION=memory_chunks
# Task-Dedup raw-cosine-Schwelle (modellspezifisch; nomic≈0.85, bge-m3 spreizt
# breiter → nach Migration an echten Scores rekalibrieren).
MAYRING_TASK_SIM_THRESHOLD=0.85

# ── MCP / FastAPI ──────────────────────────────────────────────────────────
APP_BASE_URL=https://mcp.linn.games
MCP_TRANSPORT=stdio
MCP_HTTP_PORT=8092
MCP_HTTP_HOST=0.0.0.0

# ── Auth: RS256 JWT ─────────────────────────────────────────────────────────
# Default-on. Code-default in src/api/mcp_auth.py ist 'true' (Sicherheit:
# vergessenes env-var auf prod darf NICHT silent auth deaktivieren).
# Lokales Dev opt-out via MCP_AUTH_ENABLED=false (eigene Datei .env.local).
MCP_AUTH_ENABLED=true
JWT_PUBLIC_KEY_PATH=./secrets/jwt_public.pem
JWT_ISSUER=https://app.linn.games
JWT_AUDIENCE=mayringcoder
MCP_SERVICE_TOKEN=

# ── Pi Agent ───────────────────────────────────────────────────────────────
PI_REPO_SLUG=Nileneb/app.linn.games

# ── Docker (Production) ────────────────────────────────────────────────────
MAYRING_API_URL=http://mayring-api:8090
LARAVEL_NETWORK=linn-shared
MAYRING_PORT=6480
CLAUDE_PROJECTS_DIR=
